{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(mypy*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout -b*)",
      "Bash(python -m experiments*)",
      "Read(src/**)",
      "Read(tests/**)",
      "Read(docs/**)",
      "Read(configs/**)",
      "Read(experiments/**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(experiments/**)",
      "Edit(configs/**)",
      "Edit(docs/lab-notebook/**)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh pr*)",
      "Bash(pip install*)",
      "Bash(uv*)",
      "Edit(pyproject.toml)",
      "Edit(CLAUDE.md)",
      "Edit(.github/**)",
      "Edit(paper/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(rm -rf*)",
      "Edit(docs/decisions/0000-template.md)",
      "Edit(docs/decisions/0001-windowed-median-vergence.md)",
      "Edit(docs/decisions/0002-saliency-validity-masking.md)",
      "Edit(docs/decisions/0003-foveal-confinement-linearization-error.md)",
      "Edit(docs/decisions/0004-layer-module-boundaries.md)",
      "Edit(docs/decisions/0005-uncertainty-first-class.md)",
      "Edit(docs/decisions/0006-scenes-as-a-separate-package.md)",
      "Edit(docs/decisions/0007-offaxis-not-toein.md)",
      "Edit(docs/decisions/0008-python-floor-312.md)",
      "Edit(docs/decisions/0009-blender-api-version-adaptive.md)",
      "Edit(docs/decisions/0010-multilayer-exr-not-compositor.md)",
      "Edit(docs/decisions/README.md)",
      "Edit(data/**)",
      "Read(.env)",
      "Read(**/*.key)",
      "Read(**/credentials*)"
    ]
  }
}
