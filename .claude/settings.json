{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(mypy*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current*)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git checkout -b*)",
      "Bash(python -m experiments*)",
      "Read(src/**)",
      "Read(tests/**)",
      "Read(docs/**)",
      "Read(configs/**)",
      "Read(experiments/**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(experiments/**)",
      "Edit(configs/**)",
      "Edit(docs/lab-notebook/**)",
      "Edit(docs/method/**)",
      "Edit(docs/roadmap.md)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh pr*)",
      "Bash(pip install*)",
      "Bash(uv*)",
      "Edit(pyproject.toml)",
      "Edit(CLAUDE.md)",
      "Edit(.github/**)",
      "Edit(paper/**)",
      "Edit(docs/decisions/README.md)",
      "Edit(docs/decisions/0*.md)",
      "Write(docs/decisions/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git update-ref*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git gc --prune*)",
      "Bash(git prune*)",
      "Bash(git checkout -B*)",
      "Bash(git switch -C*)",
      "Bash(git switch --force-create*)",
      "Bash(git branch -f*)",
      "Bash(git branch --force*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(sed -i*docs/decisions/*)",
      "Bash(tee*docs/decisions/*)",
      "Bash(*>docs/decisions/*)",
      "Bash(*> docs/decisions/*)",
      "Edit(data/**)",
      "Read(.env)",
      "Read(**/*.key)",
      "Read(**/credentials*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/adr_append_only.py\"",
            "timeout": 10,
            "statusMessage": "Checking ADR append-only rule"
          }
        ]
      }
    ]
  }
}
