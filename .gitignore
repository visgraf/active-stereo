# Results are reproducible from configs + run-ids; never versioned.
results/
!results/.gitkeep

# Data blobs live behind DVC / git-lfs pointers.
data/**
!data/.gitkeep
!data/*.dvc
!data/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# LaTeX build artefacts (Overleaf syncs source only)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/main.pdf

# Blender
*.blend1

# OS / editor
.DS_Store
.idea/
.vscode/settings.json

# Emacs
\#*\#
.\#*
*~
.DS_Store

# Self-contained slide decks: figures are embedded as base64, so the HTML is
# multi-MB and fully derived. Rebuild with
#     python scripts/build_deck.py slides/<deck>
# after regenerating that deck's figures with its make_*_slides.py.
slides/*/deck.html
